# Copy to .env.local. All values are public (NEXT_PUBLIC_*) and end up in the browser bundle.
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ATTESTOR_URL=http://127.0.0.1:8000
# 1 = persona switcher with PUBLIC Anvil test keys (local chain 31337 only). Anything else = injected wallet.
NEXT_PUBLIC_DEMO_MODE=1
# optional; else <attestor>/bundle/<cid>.  e.g. https://gateway.pinata.cloud/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=
