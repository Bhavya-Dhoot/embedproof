# Copy to attestor/.env (never commit it). Real environment variables win over this file.

# --- chain -------------------------------------------------------------------------------
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Attestor signing key (must hold ATTESTOR_ROLE). Optional ONLY for chain 31337, where it
# defaults to the public Anvil key #1. Required (and a fresh key!) for Base Sepolia / anything real.
# ATTESTOR_PRIVATE_KEY=0x...
# Folder with <chainId>.json and abi/*.json written by the contracts deploy. Default: <repo>/deployments
# DEPLOYMENTS=../deployments

# --- storage -------------------------------------------------------------------------------
# sqlite db, ML-DSA keys and the local content-addressed IPFS store. Default: attestor/var
# DATA_DIR=attestor/var
# Optional Pinata (v3 files API) mirror. The CID Pinata returns must equal the locally computed
# CIDv1/raw/sha2-256, otherwise /attest refuses. Without it the local store is the only gateway.
# PINATA_JWT=
# Optional public gateway used by GET /bundle|/verify for CIDs missing from the local store (e.g. https://gateway.pinata.cloud)
# IPFS_GATEWAY=

# --- ML-DSA-44 ---------------------------------------------------------------------------------
# Force one backend instead of the default order oqs -> pqcrypto -> dilithium_py
# PQ_BACKEND=pqcrypto

# --- HTTP -------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Token bucket per client IP on /score, /attest, /reasons (separate bucket per route)
RATE_BURST=20
RATE_PER_SEC=2
# Header carrying the real client IP when behind a trusted proxy (Fly: fly-client-ip). Leave empty otherwise,
# or clients could spoof their address and dodge the limiter.
# CLIENT_IP_HEADER=fly-client-ip

# --- demo runner (python -m attestor.demo) -------------------------------------------------------
# ATTESTOR_URL=http://127.0.0.1:8000
