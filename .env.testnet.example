# Base Sepolia deployment settings. Copy to .env.testnet (gitignored) and fill it in.
# Never commit the filled file, and never reuse the public Anvil keys here.
# Use four separate wallets for the four *_KEY values, and give each one some Base Sepolia ETH
# from a faucet before deploying (0.01 ETH each is plenty on Base Sepolia).

RPC_URL=https://sepolia.base.org

# Deployer. It becomes ADMIN and the timelock proposer/executor, registers the demo installations
# and anchors the attestor's ML-DSA key hash.
PRIVATE_KEY=0x

# Attestor. It signs attest() transactions. The hosted attestor on Fly holds this key as a secret.
ATTESTOR=0x
ATTESTOR_PRIVATE_KEY=0x

# Verifier. It reviews red claims, and the hosted demo runner uses this key.
VERIFIER=0x
DEMO_VERIFIER_KEY=0x

# Exporter. It operates both demo installations (TR-EAF-0001, TR-BOF-0002) and allocates tonnes.
# The demo runner uses this key. Set EXPORTER_A and EXPORTER_B to this key's address.
EXPORTER_A=0x
EXPORTER_B=0x
DEMO_EXPORTER_KEY=0x

# Addresses only, no funds needed: the regulator role and the two demo importers.
REGULATOR=0x
IMPORTER_A=0x
IMPORTER_B=0x

# Optional. An Etherscan API v2 key verifies the source on basescan, so the explorer decodes
# DoubleClaimBlocked in the failed transaction.
ETHERSCAN_API_KEY=
# Optional. Pins bundles to IPFS through Pinata; without it, bundles stay on the attestor's Fly volume.
PINATA_JWT=
